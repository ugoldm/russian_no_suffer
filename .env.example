# Local demonstration: npm run dev. Shared production: set mode to supabase.
VITE_APP_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional public Turnstile site key. Never use a secret key here.
VITE_TURNSTILE_SITE_KEY=
# /russian_no_suffer/ for a GitHub project page; / for local or custom domain.
VITE_BASE_PATH=/
